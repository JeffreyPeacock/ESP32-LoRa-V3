# Meshtastic listener configuration.
#
# Copy to etc/secrets/listener.conf and fill in. The real file carries a phone
# number and an email address, so it belongs under etc/secrets/, which is
# gitignored as a whole directory. This example is tracked and must stay free
# of real addresses.

[listen]
# The radio. Use a /dev/serial/by-path/ name, not /dev/ttyUSBn: numbering
# shifts when other radios are plugged in. A by-path name is the USB *socket*,
# so re-read it with ./scripts/heltec-dev.sh ports after moving a board.
port = /dev/serial/by-path/pci-0000:00:14.0-usb-0:3:1.0-port0

# true  -- forward only messages addressed to this node (direct messages)
# false -- also forward broadcasts, subject to the channel allowlist below
dm_only = true

# Which radio this listener speaks for, matched against "deviceId" in the
# phone book. Leave blank to take it from the radio's own short name, which
# is one fewer place for the two to get out of step.
device_id =

# Only consulted when dm_only = false. Empty means every channel. Names are
# the channel names as configured on the radio; channel 0 is "primary".
channels =

# Every message the listener sees is appended here as one JSON object per
# line, whether or not it was forwarded, with the decision recorded.
ledger = etc/secrets/received.jsonl

# How long to wait before reopening the port after the radio goes away.
reconnect_secs = 15

[mail]
# Both email and SMS go through the local MTA. Postfix on this host relays
# outbound through a smarthost, so nothing else needs configuring.
sendmail = /usr/sbin/sendmail

# Two things below are NOT ours to set, and it is worth knowing which:
#
# The From address you see on the handset is decided by postfix, not here.
# smtp_generic_maps rewrites the sender on the way out; a line like
#   @thishost    someone@example.com
# in /etc/postfix/generic replaces whatever "from" says above. Change it by
# adding a MORE specific entry (a full address beats a bare @host) and running
# postmap, then confirm the smarthost will accept that sender for the
# authenticated account -- many relays refuse a sender they do not own.
#
# A "[Potential Spam]" or similar subject tag is added upstream, by the relay
# or by the receiving carrier. Nothing on this host does it. Giving the message
# a real subject helps a little; the real fix is an allowlist on whichever
# system is tagging it.

[email]
enabled = true
to = you@example.com
from = ftg1@localhost
subject_prefix = [FTG1]

# str.format over the ledger fields, plus {prefix} and {who}. Any field in a
# ledger row is available: text, from_id, from_short, from_long, channel_name,
# rx_snr, rx_rssi, hops_away, received_at, and the rest.
subject_template = {prefix} message from {who}

[sms]
# A carrier email-to-SMS gateway. Google Fi's is <10 digits>@msg.fi.google.com.
# Gateways drop messages silently and give no delivery receipt -- if a message
# has to arrive, this is the wrong transport.
enabled = true
from = ftg1@localhost

# Recipients, keyed by device, so adding a person is a data change rather than
# a config change and a second radio can route somewhere else entirely:
#
#   [{"deviceId": "FTG1", "name": "Jeffrey", "phone": "5555550123"}]
#
# deviceId is matched against [listen] device_id, or against the radio's own
# short name when that is blank. "gateway" and "enabled" are optional per
# entry. Numbers are validated as 10 US digits at startup, because a carrier
# gateway discards mail for an address it does not recognise without saying so.
phones_file = etc/secrets/sms-phones.json

# Appended to a bare number from the phone book. Override per entry for a
# recipient on a different carrier.
gateway = msg.fi.google.com

# Literal addresses, applied for every device regardless of the phone book.
# Usually left empty; the phone book is the better place.
to =

# Several gateways prepend the subject to the message body, so it costs
# characters that are already scarce -- but an ABSENT Subject header is itself
# a spam signal (SpamAssassin's MISSING_SUBJECT and friends), and a
# "[Potential Spam]" tag is a subject rewrite, so a filter will invent one
# anyway. Give it a short real subject and keep the body from repeating it.
subject = FTG1 mesh

# What the text message says. str.format over the same ledger fields as the
# email subject. {text} is truncated to whatever room the rest of the template
# leaves, so anything you put after it survives; the total lands on max_chars.
# An unknown field renders as <name?> and a malformed template falls back to
# the bare text -- a typo should look wrong, not stop the listener.
body_template = {text} [{from_short} {rx_snr}dB]

# Total length of the rendered message.
max_chars = 140

# A ceiling, so a chatty channel or a rebroadcast loop cannot run up a bill or
# get the gateway to rate-limit us. Messages above it are recorded in the
# ledger and logged, but not sent.
max_per_hour = 20
