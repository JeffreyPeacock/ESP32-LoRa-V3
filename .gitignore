# PlatformIO build output. Toolchains and frameworks live in ~/.platformio,
# outside the project, and are never committed.
.pio/

# JetBrains project state. workspace.xml and the .iml carry absolute local
# paths and per-user settings, so the whole directory stays out.
.idea/

# Scratch space, not part of the project.
.claude_artifacts/

# Third-party installer, downloaded on demand by scripts/install-toolchain.sh.
get-platformio.py

# Exported device configuration can contain channel pre-shared keys.
*.config.yaml
device-config.yaml

# All local secrets live in one place so we know where they are.
# Device config exports carry channel PSKs, the node private key and the WiFi
# PSK. Ignore the directory itself, not just what we happen to name today.
etc/secrets/
secrets/

# Claude Code: commands and shared settings are committed; per-user permission
# grants are not.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local-only notes. Peer positions are other operators' locations: useful for
# making contact locally, not ours to publish.
*.local.md
*.local.json
docs/*.local.*

# Local-only scripts. These carry credentials (WiFi PSK, broker passwords) and
# must never reach a public repository.
*.local.sh
scripts/local-*.sh

# A contributor's plain virtualenv, if they use one instead of pyenv.
.venv/
